{
    "name": "Orders Api Example",
    "dockerComposeFile": "../compose.yaml",
    "service": "orders-api-example",
    "workspaceFolder": "/app",
    "initializeCommand": "make up",
    "overrideCommand": false,
    "updateRemoteUserUID": true,
    "shutdownAction": "stopCompose",
    "remoteUser": "robbyte",
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "junstyle.php-cs-fixer",
                "swordev.phpstan",
                "xdebug.php-debug",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "ms-vscode.vscode-typescript-next",
                "christian-kohler.path-intellisense"
            ],
            "settings": {
                "php.validate.executablePath": "/usr/local/bin/php",
                "php.debug.idekey": "PHPSTORM",
                "remote.restoreEditors": false,
                "workbench.startupEditor": "none",
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    }
                },
                "[php]": {
                    "editor.defaultFormatter": "junstyle.php-cs-fixer",
                    "editor.formatOnSave": true
                },
                "php-cs-fixer.executablePath": "/app/src/vendor/bin/php-cs-fixer",
                "php-cs-fixer.onsave": true,
                "php-cs-fixer.config": "/app/src/.php-cs-fixer.dist.php",
                "phpstan.enabled": true,
                "phpstan.binPath": "/app/src/vendor/bin/phpstan",
                "phpstan.configFile": "/app/src/phpstan.neon",
                "phpstan.rootDir": "/app/src",
                "intelephense.environment.includePaths": [
                    "/app/src/vendor"
                ]
            }
        }
    }
}
